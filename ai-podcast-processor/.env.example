# AI Podcast Processor - Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# API KEYS (Required)
# ===========================================

# OpenAI API key for Whisper transcription
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic API key for Claude summarization
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# AssemblyAI API key (optional, alternative to Whisper)
# Get yours at: https://www.assemblyai.com/dashboard/signup
# ASSEMBLYAI_API_KEY=your-assemblyai-api-key-here

# ===========================================
# TRANSCRIPTION SETTINGS
# ===========================================

# Which service to use: 'whisper' or 'assemblyai'
# - whisper: Faster, cheaper ($0.006/min), no speaker diarization
# - assemblyai: Better quality, speaker diarization ($0.37/hour)
TRANSCRIPTION_SERVICE=whisper

# Whisper model (default: whisper-1)
WHISPER_MODEL=whisper-1

# ===========================================
# SUMMARIZATION SETTINGS
# ===========================================

# Claude model to use for summarization
# Options: claude-sonnet-4-20250514, claude-3-5-sonnet-20241022, claude-3-haiku-20240307
CLAUDE_MODEL=claude-sonnet-4-20250514

# ===========================================
# DATABASE SETTINGS
# ===========================================

# Database type: 'sqlite' or 'postgresql'
DB_TYPE=sqlite

# SQLite database path (relative to project root)
SQLITE_PATH=data/podcast.db

# PostgreSQL settings (if using PostgreSQL)
# PG_HOST=localhost
# PG_PORT=5432
# PG_DATABASE=podcast_processor
# PG_USER=postgres
# PG_PASSWORD=your-password

# ===========================================
# STORAGE SETTINGS
# ===========================================

# Base directory for audio, transcripts, and summaries
STORAGE_DIR=data

# ===========================================
# SCHEDULER SETTINGS
# ===========================================

# Enable automatic scheduling
SCHEDULER_ENABLED=true

# Check interval in hours (alternative to cron)
CHECK_INTERVAL_HOURS=24

# Cron expression for scheduling (default: Monday at 8 AM)
# Format: minute hour day_of_month month day_of_week
CRON_EXPRESSION=0 8 * * MON

# ===========================================
# EMAIL NOTIFICATIONS (Optional)
# ===========================================

# EMAIL_ENABLED=false
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# EMAIL_FROM=your-email@gmail.com
# EMAIL_TO=recipient@example.com
# EMAIL_PASSWORD=your-app-password

# ===========================================
# DEBUG MODE
# ===========================================

DEBUG=false
